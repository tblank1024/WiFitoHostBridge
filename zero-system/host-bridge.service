# filepath: /etc/systemd/system/host-bridge.service
[Unit]
Description=Host Bridge Service for WiFi Configuration
# Wait for the network stack to be fully online, including IP address assignment
After=network-online.target
Wants=network-online.target

[Service]
# User=root # Service runs as root by default, uncomment if needed explicitly
# Group=root # Optional

# Set the working directory to where the script resides
WorkingDirectory=/path/to/your/script/

# Command to execute the script using python3
# Use full paths for reliability
ExecStart=/usr/bin/python3 /path/to/your/script/host-bridge.py

